{
  "name": "@moc-global/loft-aws-s3-repository",
  "version": "1.1.0",
  "description": "AWS S3 manifest repository for the LOFT framework",
  "keywords": [
    "loft",
    "llm",
    "llm-orchestration",
    "typescript",
    "aws",
    "s3",
    "manifest"
  ],
  "homepage": "https://github.com/MoC-OSS/LOFT/tree/main/packages/loft-manifest-s3-strategy#readme",
  "bugs": {
    "url": "https://github.com/MoC-OSS/LOFT/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MoC-OSS/LOFT.git",
    "directory": "packages/loft-manifest-s3-strategy"
  },
  "license": "MIT",
  "author": "Master of Code Global",
  "type": "commonjs",
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./lib/index.d.mts",
        "default": "./lib/index.mjs"
      },
      "require": {
        "types": "./lib/index.d.ts",
        "default": "./lib/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.declarations.json && node ../../scripts/emit-esm-types.mjs",
    "test": "vitest run",
    "test:local": "chmod +x ./run_tests.sh && ./run_tests.sh",
    "test:local:coverage": "./run_tests.sh --coverage",
    "check-types": "tsc --noEmit --skipLibCheck -p tsconfig.json",
    "lint": "npx eslint ./src --fix",
    "lint:check": "npx eslint ./src --max-warnings=0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1140.0"
  },
  "peerDependencies": {
    "@moc-global/loft-definitions": "workspace:^",
    "inversify": "^6.2.2",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@moc-global/loft-definitions": "workspace:*",
    "aws-sdk-client-mock": "^4.0.1",
    "inversify": "^6.2.2",
    "reflect-metadata": "^0.2.2",
    "zod": "4.6.7"
  }
}
