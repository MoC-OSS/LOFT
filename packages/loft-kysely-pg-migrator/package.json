{
  "name": "@moc-global/loft-kysely-pg-migrator",
  "version": "1.0.4",
  "engines": {
    "node": ">=22"
  },
  "private": true,
  "description": "Shared Kysely PostgreSQL migrator for LOFT Framework",
  "license": "MIT",
  "main": "./lib/index.js",
  "module": "./lib/index.mjs",
  "types": "./lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/index.mjs",
      "require": "./lib/index.js"
    },
    "./cli": {
      "types": "./lib/cli.d.ts",
      "import": "./lib/cli.mjs",
      "require": "./lib/cli.js"
    }
  },
  "typesVersions": {
    "*": {
      "cli": [
        "./lib/cli.d.ts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "lib",
    "src",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsup && tsc -p tsconfig.declarations.json",
    "check-types": "tsc --noEmit --skipLibCheck -p tsconfig.json",
    "lint": "npx eslint ./src --fix",
    "lint:check": "npx eslint ./src --max-warnings=0"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "kysely": "^0.28.17",
    "pg": "^8.11.4",
    "yargs": "^17.7.2",
    "zod": "3.25.67"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "@types/pg": "^8.23.1",
    "@types/yargs": "^17.0.32"
  }
}
