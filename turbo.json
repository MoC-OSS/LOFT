{
  "$schema": "https://turborepo.com/schema.json",
  "globalDependencies": [
    "scripts/emit-esm-types.mjs"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "prebuild",
        "^build"
      ],
      "outputs": [
        "lib/**",
        "dist/**"
      ]
    },
    "prebuild": {},
    "lint": {},
    "lint:check": {},
    "check-types": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}
