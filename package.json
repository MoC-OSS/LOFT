{
  "name": "loft-mono",
  "description": "LOFT monorepo",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build-packages": "turbo run build --filter='./packages/*' --filter='./integration'",
    "build:examples": "turbo run build --filter='./examples/*'",
    "build:all": "turbo run build",
    "typecheck": "turbo run check-types --filter='./packages/*' --filter='./integration'",
    "lint:check": "turbo run lint:check --filter='./packages/*' --filter='./integration'",
    "lint:examples": "turbo run lint --filter='./examples/*'",
    "check-types:examples": "turbo run check-types --filter='./examples/*'",
    "changeset": "npx @changesets/cli",
    "versions:check": "manypkg check",
    "versions:align": "manypkg fix",
    "publish-packages": "turbo run build && npx @changesets/cli version && npx @changesets/cli publish",
    "test:unit:coverage": "vitest run packages --coverage",
    "test:integration": "pnpm run --filter=loft-integration-tests test",
    "test:integration:esm": "pnpm run --filter=loft-integration-tests test:esm",
    "test:integration:cjs": "pnpm run --filter=loft-integration-tests test:cjs",
    "smoke:imports": "node scripts/smoke-imports.mjs",
    "check:manifests": "node scripts/check-packages.mjs publint",
    "check:types-exports": "node scripts/check-packages.mjs attw",
    "check:tarballs": "node scripts/check-tarballs.mjs",
    "check:consumer": "node scripts/check-consumer.mjs",
    "check:readme-snippets": "node scripts/check-readme-snippets.mjs",
    "test:unit": "vitest run packages",
    "prepare": "husky",
    "precommit:verify": "./.husky/pre-commit"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@manypkg/cli": "^0.25.1",
    "@moc-global/loft-base-tsconfig": "workspace:*",
    "@moc-global/loft-definitions": "workspace:*",
    "@moc-global/loft-kysely-pg-migrator": "workspace:*",
    "@moc-global/loft-pglite": "workspace:*",
    "@moc-global/loft-test-suite": "workspace:*",
    "@types/node": "^20.14.2",
    "@types/pg": "^8.23.1",
    "@types/yargs": "^17.0.32",
    "@typescript-eslint/eslint-plugin": "^7.9.0",
    "@typescript-eslint/parser": "^7.9.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dotenv": "^16.4.5",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.0",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^12.0.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "husky": "^9.0.11",
    "lint-staged": "^16.1.5",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "turbo": "^2.11.7",
    "typescript": "^5.8.3",
    "vitest": "^3.2.7"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": "eslint --fix"
  },
  "packageManager": "pnpm@10.14.0",
  "workspaces": [
    "packages/*",
    "integration",
    "examples/*"
  ],
  "manypkg": {
    "workspaceProtocol": "require",
    "ignoredRules": []
  }
}
