# Copy to .env.test. Every setting is optional: without this file the offline tests run on an in-process PGlite
# database and the live tests (*.live.test.ts) are skipped.

# LOFT's log level during the tests: NONE, FATAL (default), ERROR, WARN, INFO, DEBUG or TRACE
# LOFT_LOG_LEVEL=FATAL

# Run against a PostgreSQL server instead of PGlite; each test file creates and drops a database of its own
# (the user needs the CREATEDB privilege).
# docker compose -f docker-compose.dev.yml up -d starts one; use the user, password and database set in that file.
# LOFT_TEST_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/<database>

# Live tests: each runs only when its keys are set
# loft.tool-calls.live.test.ts (OpenAI and Anthropic, each when its key is set)
LOFT_OPENAI_API_KEY=
LOFT_ANTHROPIC_API_KEY=

# loft.gemini.live.test.ts: a Vertex AI project, with Application Default Credentials for it
LOFT_GEMINI_VERTEX_PROJECT=
# LOFT_GEMINI_VERTEX_LOCATION=us-central1

# loft.langfuse.live.test.ts: a Langfuse project; src/langfuse-docker-compose.yml runs Langfuse locally
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_HOST=
