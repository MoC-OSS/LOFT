# express-basic — Stateless single-turn chat, no external database
# Copy to .env and set your OpenAI API key

OPENAI_API_KEY=sk-your-openai-api-key
LOFT_MANIFEST_PATH=manifest/manifest.json
LOFT_MANIFEST_ERROR_PATH=manifest/errors/error.json
LOFT_MANIFEST_CACHE_EXPIRATION=3600000
LOFT_LOG_LEVEL=INFO
PORT=3001
