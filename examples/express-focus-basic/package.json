{
  "name": "@moc-global/example-express-focus-basic",
  "version": "0.0.1",
  "private": true,
  "description": "Pizza Order Bot — Express + LOFT Focus for structured data collection across multi-turn conversations",
  "license": "MIT",
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "dev": "tsx watch src/index.ts",
