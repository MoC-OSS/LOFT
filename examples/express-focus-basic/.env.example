# Required
ANTHROPIC_API_KEY=your-api-key-here

# Express
PORT=3006

# LOFT
LOFT_LOG_LEVEL=INFO
LOFT_MANIFEST_PATH=manifest/manifest.json
LOFT_MANIFEST_ERROR_PATH=manifest/errors/error.json
LOFT_MANIFEST_CACHE_EXPIRATION=3600000

# PostgreSQL (Docker — matches examples/docker-compose.yml)
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=loft_example
POSTGRES_PASSWORD=loft_example_pass
POSTGRES_DB=loft_examples
LOFT_SESSION_SCHEMA=loft_session
LOFT_CHAT_HISTORY_SCHEMA=loft_chat_history
