# =============================================================================
# LOFT Examples — Shared Environment Variables
# =============================================================================
# Copy this file to the specific example directory as .env, then fill in values.
# Example: cp examples/.env.example examples/express-basic/.env

# --- LLM API Keys (provide at least one) ---
OPENAI_API_KEY=sk-your-openai-api-key
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# --- PostgreSQL Connection (only for express-full, which uses Docker PostgreSQL) ---
# Other examples use PGLite (in-process) and do not need these.
# Note: These POSTGRES_* vars are used by the express-full application code.
# The migration CLIs use DATABASE_URL (a connection string) — see examples/README.md.
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=loft_example
POSTGRES_PASSWORD=loft_example_pass
POSTGRES_DB=loft_examples

# --- LOFT Database Schemas ---
LOFT_SESSION_SCHEMA=loft_session
LOFT_CHAT_HISTORY_SCHEMA=loft_chat_history

# --- LOFT Manifest ---
LOFT_MANIFEST_PATH=manifest/manifest.json
LOFT_MANIFEST_ERROR_PATH=manifest/errors/error.json
LOFT_MANIFEST_CACHE_EXPIRATION=3600000

# --- Logging ---
LOFT_LOG_LEVEL=INFO
